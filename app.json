{
  "expo": {
    "name": "MathQuest 9 - The Lost Kingdom of Numeria",
    "slug": "MathQuest9",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/image/dcmg9logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/image/hero.png",
      "resizeMode": "cover",
      "backgroundColor": "#050814"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mathquest9.app"
    },
    "android": {
      "package": "com.mathquest9.app",
      "adaptiveIcon": {
        "foregroundImage": "./src/image/dcmg9logo.png",
        "backgroundColor": "#6C63FF"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 1
    },
    "web": {
      "favicon": "./src/image/dcmg9logo.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
