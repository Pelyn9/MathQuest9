{
  "expo": {
    "name": "MathQuest 9 - The Lost Kingdom of Numeria",
    "slug": "MathQuest9",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050814"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mathquest9.app"
    },
    "android": {
      "package": "com.mathquest9.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6C63FF"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
